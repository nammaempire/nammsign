rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// nammsign — Firebase Storage security rules
// Last reviewed: 2026-05-16
// Project: namma-empire (asia-south1)
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    // ── /kyc/{userId}/...  KYC documents (Aadhar / GST / COI) ─────────────
    //   • PRIVATE: only the owner who uploaded + admin can read.
    //   • Owner can write only their own folder.
    //   • Size cap: 10 MB per document.
    //   • Content type must be PDF or common image format.
    match /kyc/{userId}/{file=**} {
      allow read:  if request.auth != null
                   && (request.auth.uid == userId
                       || request.auth.token.admin == true);

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('image/.*'));
    }

    // ── /ads/{userId}/{adId}/...  Ad creatives (image / video) ────────────
    //   • PUBLIC read: required so the TV player at signage locations can
    //     download ad media without authenticating each device.
    //   • Owner can write only inside their own user folder.
    //   • Size cap: 100 MB per file (videos can be large).
    //   • Content type must be image or video.
    match /ads/{userId}/{adId}/{file=**} {
      allow read:  if true;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 100 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));
    }

    // ── /slots/{slotId}/...  Signage board photos ─────────────────────────
    //   • Public read so the app's Local tab can show slot photos.
    //   • Only admin uploads / replaces these.
    //   • Size cap: 20 MB per image.
    match /slots/{slotId}/{file=**} {
      allow read:  if true;

      allow write: if request.auth != null
                   && request.auth.token.admin == true
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Default deny ──────────────────────────────────────────────────────
    // Any path not matched above is denied.
  }
}
